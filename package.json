{
  "name": "uniquelaserclinics",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:dev:android": "npx eas-cli@14.7.1 build --profile development --platform android",
    "typecheck": "tsc --noEmit",
    "seed": "node services/seed.ts",
    "verify": "node services/verify-schema.ts",
    "verify:rls": "node services/verify-schema.ts --rls-only"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant": "^0.4.2",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "~57.0.19",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.18",
    "expo-secure-store": "^58.0.2",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "~19.2.2",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
